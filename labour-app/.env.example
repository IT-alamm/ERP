# Optional for Expo Go on same WiFi (app auto-uses laptop LAN IP, port 8080).
# REQUIRED for production builds (baked in at build time via EAS env / .env).
EXPO_PUBLIC_API_URL=
# Example laptop LAN: EXPO_PUBLIC_API_URL=http://192.168.1.50:8080/api/v1
# Example hosted backend: EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
